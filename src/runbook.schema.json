{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-runbook.local/schema/runbook-v2.json",
  "title": "Tech Runbook v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "description", "category", "tags", "startNode", "nodes"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"$ref": "#/$defs/localizedString"},
    "description": {"$ref": "#/$defs/localizedString"},
    "category": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/localizedString"}},
    "operatingSystems": {"type": "array", "items": {"type": "string"}},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {"type": "string"},
        "version": {"type": "string"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "createdFrom": {"type": "string"}
      }
    },
    "startNode": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "localizedString": {
      "anyOf": [
        {"type": "string"},
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "es": {"type": "string"},
            "en": {"type": "string"}
          }
        }
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "alt"],
      "properties": {
        "type": {"enum": ["image", "video"]},
        "url": {"type": "string", "minLength": 1},
        "alt": {"$ref": "#/$defs/localizedString"},
        "caption": {"$ref": "#/$defs/localizedString"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"$ref": "#/$defs/localizedString"},
        "nextNode": {"type": "string", "minLength": 1},
        "description": {"$ref": "#/$defs/localizedString"},
        "media": {"type": "array", "items": {"$ref": "#/$defs/media"}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "type": {"enum": ["question", "action", "command", "check", "warning", "solution", "troubleshooting", "visual-identification", "note", "multimedia"]},
        "title": {"$ref": "#/$defs/localizedString"},
        "body": {"$ref": "#/$defs/localizedString"},
        "os": {"type": "array", "items": {"type": "string"}},
        "command": {"type": "string"},
        "expectedResult": {"$ref": "#/$defs/localizedString"},
        "destructive": {"type": "boolean"},
        "media": {"type": "array", "items": {"$ref": "#/$defs/media"}},
        "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}},
        "nextNode": {"type": "string", "minLength": 1},
        "symptoms": {"type": "array", "items": {"$ref": "#/$defs/localizedString"}},
        "errorMessages": {"type": "array", "items": {"type": "string"}},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/localizedString"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "cause": {"$ref": "#/$defs/localizedString"},
        "finalSolution": {"$ref": "#/$defs/localizedString"}
      }
    }
  }
}
