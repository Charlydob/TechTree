{
 "compilerOptions":{
  "composite":true,
  "target":"ES2022",
  "lib":["ES2022","DOM"],
  "module":"ESNext",
  "moduleResolution":"Bundler",
  "resolveJsonModule":true,
  "allowSyntheticDefaultImports":true,
  "esModuleInterop":true,
  "strict":true,
  "skipLibCheck":true,
  "noEmit":true
 },
 "include":["backend/**/*.ts","src/lib/**/*.ts","src/types.ts","src/runbook.schema.json"]
}
